NPC: sebastian_wick
LOCATION: upper_residential_ridge
SCHEDULE: dawn={veranda}, midday={study}, evening={club_carriage_stop}

# Retired attorney. Not a cultist.
# Knows procedure, records, omissions.

TOPIC: default
  GATE: NOT topic_done(sebastian_wick, default)
  VOICE: trombone_bureaucratic_short_v1
  MR. WICK: "You are either here officially or personally."
  VOICE: trombone_bureaucratic_short_v2
  MR. WICK: "The distinction matters more than most officers realize."

# Plain coat defaults: legal counsel vs evidence, patience of common law
TOPIC: default
  GATE: topic_done(sebastian_wick, default) AND coat = plain
  TAG: wick_repeat_plain_veranda
  WEIGHT: 3
  [Mr. Wick looks over his iron spectacles from a wicker chair on the veranda.]
  VOICE: trombone_neutral_medium_v1
  MR. WICK: "Without the uniform, Corwin, an attorney might almost mistake you for someone seeking legal counsel rather than evidence."

TOPIC: default
  GATE: topic_done(sebastian_wick, default) AND coat = plain
  TAG: wick_repeat_plain_statutes
  WEIGHT: 2
  VOICE: trombone_cautious_short_v1
  MR. WICK: "The common law is very patient with things men prefer to forget. Good afternoon."

# Police coat / badge defaults: subpoenas, procedure as shield
TOPIC: default
  GATE: topic_done(sebastian_wick, default) AND coat != plain
  TAG: wick_repeat_badge_subpoena
  WEIGHT: 3
  VOICE: trombone_bureaucratic_medium_v2
  MR. WICK: "If you carry no subpoena signed by the magistrate, Officer, this is merely an interruption of my morning tea."

TOPIC: default
  GATE: topic_done(sebastian_wick, default) AND coat != plain
  TAG: wick_repeat_badge_procedure
  WEIGHT: 2
  [He turns a page of his legal journal without looking up.]
  VOICE: trombone_dismissive_short_v1
  MR. WICK: "Procedure is the only shield between a town and catastrophe, Corwin. Mind yours."

TOPIC: records
  GATE: always
  TAG: wick_records
  LABEL: "Ask about missing records"
  WALTER CORWIN: "How does a document disappear?"
  VOICE: trombone_neutral_short_v2
  MR. WICK: "Usually without disappearing at all."
  VOICE: trombone_neutral_short_v1
  MR. WICK: "A filing decision here. A transfer there."
  VOICE: trombone_neutral_medium_v2
  MR. WICK: "Eventually everyone involved can justify his own part in the loss."

TOPIC: claim
  GATE: evidence(lay_lead)
  TAG: wick_claim
  LABEL: "Ask about an old wage claim"
  WALTER CORWIN: "Can a century-old debt still exist?"
  VOICE: trombone_questioning_short_v1
  MR. WICK: "Exist? Certainly."
  VOICE: trombone_questioning_short_v2
  MR. WICK: "Be collected? That depends which family owes it."
  NOTEBOOK: wick_claim_1 | "Legal existence and practical enforceability are separate questions."
  EVIDENCE: legal_claim

TOPIC: filing
  GATE: coat = plain AND NOT topic_done(sebastian_wick, filing)
  TAG: wick_plain
  LABEL: "Ask what he would do"
  VOICE: trombone_neutral_medium_v2
  MR. WICK: "If I wished something buried, I would not destroy it."
  WALTER CORWIN: "What would you do?"
  VOICE: trombone_bureaucratic_medium_v1
  MR. WICK: "I would ensure every surviving copy was perfectly filed."