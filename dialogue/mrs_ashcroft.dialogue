NPC: miriam_ashcroft
LOCATION: upper_residential_ridge
SCHEDULE: dawn={garden_walk}, midday={ashcroft_house}, evening={sunroom}

# Widow of a shipping family whose money predates the club but whose status
# depends on staying adjacent to it.

TOPIC: default
  GATE: NOT topic_done(miriam_ashcroft, default)
  VOICE: trombone_bureaucratic_medium_v2
  MRS. ASHCROFT: "You have climbed a long way to ask a question, Officer."
  VOICE: trombone_neutral_medium_v2
  MRS. ASHCROFT: "People generally come up here to avoid being asked one."

# Plain coat defaults: garden walks, fog from cove, lower terraces
TOPIC: default
  GATE: topic_done(miriam_ashcroft, default) AND coat = plain
  TAG: ashcroft_repeat_plain_hedge
  WEIGHT: 3
  [Mrs. Ashcroft clips a dead rose hip from a tall briar with brass shears.]
  VOICE: trombone_neutral_medium_v1
  MRS. ASHCROFT: "A plain coat makes the ridge seem less like a garrison. You may walk the lower terrace, Walter."

TOPIC: default
  GATE: topic_done(miriam_ashcroft, default) AND coat = plain
  TAG: ashcroft_repeat_plain_gardens
  WEIGHT: 2
  VOICE: trombone_weary_short_v1
  MRS. ASHCROFT: "The fog rolls up early from the cove. Don't linger until the stones get slick."

# Police coat / badge defaults: garrison feeling, flower beds, generations of patrolmen
TOPIC: default
  GATE: topic_done(miriam_ashcroft, default) AND coat != plain
  TAG: ashcroft_repeat_badge_gate
  WEIGHT: 3
  [She pauses with her shears, looking over the hedge at the uniform.]
  VOICE: trombone_bureaucratic_medium_v2
  MRS. ASHCROFT: "A badge on the garden path is an ugly ornament, Officer Corwin. We do not keep stolen silver in the flower beds."

TOPIC: default
  GATE: topic_done(miriam_ashcroft, default) AND coat != plain
  TAG: ashcroft_repeat_badge_inquiries
  WEIGHT: 2
  VOICE: trombone_dismissive_short_v1
  MRS. ASHCROFT: "The Ashcroft family has answered enough questions for three generations of patrolmen. Good day."

TOPIC: town
  GATE: always
  TAG: ashcroft_town
  LABEL: "Ask about the ridge"
  VOICE: trombone_neutral_medium_v2
  MRS. ASHCROFT: "The town prefers to imagine the hill means something."
  VOICE: trombone_neutral_medium_v1
  MRS. ASHCROFT: "It does not. The rich simply reached the top first and stayed."

TOPIC: naomi
  GATE: evidence(naomi)
  TAG: ashcroft_naomi
  LABEL: "Ask whether she knew Naomi Freeman"
  VOICE: trombone_dismissive_short_v1
  MRS. ASHCROFT: "Knew? No."
  VOICE: trombone_questioning_short_v1
  MRS. ASHCROFT: "Saw? Yes."
  VOICE: trombone_neutral_medium_v2
  MRS. ASHCROFT: "A woman asking directions to houses that had no intention of answering her."
  NOTEBOOK: ashcroft_naomi_1 | "Mrs. Ashcroft recalls seeing Naomi Freeman on the ridge, turned away door to door."
  EVIDENCE: ridge_sighting

TOPIC: club
  GATE: always
  TAG: ashcroft_club
  LABEL: "Ask about the Ophion Club"
  VOICE: trombone_neutral_short_v1
  MRS. ASHCROFT: "Men join clubs to hear themselves echoed."
  WALTER CORWIN: "Did your husband belong?"
  VOICE: trombone_neutral_short_v1
  MRS. ASHCROFT: "For eighteen years."
  VOICE: trombone_neutral_medium_v1
  MRS. ASHCROFT: "The club improved none of his opinions, but certainly increased his confidence in them."
  
TOPIC: crew_omission
  GATE: topic_done(local_historian, crew_omission_official) AND NOT topic_done(miriam_ashcroft, crew_omission)
  TAG: mrs_ashcroft_crew_omission
  LABEL: "Ask why the town's history leaves out the crew's names"
  TIME: 3
  WALTER CORWIN: "The crew who drowned in 1823. Their names don't appear anywhere."
  VOICE: trombone_dismissive_short_v1
  MRS. ASHCROFT: "No."
  WALTER CORWIN: "You've never wondered why."
  VOICE: trombone_neutral_medium_v2
  MRS. ASHCROFT: "I have wondered about a great many things this town has decided not to write down.\nWondering has not changed any of them."
  [She turns back toward the garden as if the conversation has already concluded.]
  VOICE: trombone_cautious_medium_v1
  MRS. ASHCROFT: "My husband attended eighteen years of dinners at that club.\nHe came home from each one entirely satisfied.\nI have learned to read satisfaction carefully."
  NOTEBOOK: ashcroft_crew_omission | "Mrs. Ashcroft offered no explanation for the crew's absence from the record. She implied her husband's club membership made him comfortable with what was omitted."