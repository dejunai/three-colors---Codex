NPC: ropewalk_foreman
LOCATION: waterfront
SCHEDULE: morning=waterfront_fish_stores, midday=waterfront_fish_stores, evening=closed, night=closed

TOPIC: default
  GATE: coat = plain AND visit_count(ropewalk_foreman) >= 2 AND NOT (topic_done(ropewalk_foreman, island_supply) AND topic_done(ropewalk_foreman, cellar_salt) AND topic_done(ropewalk_foreman, estate_mooring_cable))
  TAG: ropewalk_plain_repeat
  WEIGHT: 3
  VOICE: trombone_neutral_medium_v2
  ROPEWALK FOREMAN: "Still got tar on your trouser hem, Corwin.\nMind the spinning jack if you're coming down the walk."

TOPIC: default
  GATE: visit_count(ropewalk_foreman) >= 2 AND NOT (topic_done(ropewalk_foreman, island_supply) AND topic_done(ropewalk_foreman, cellar_salt) AND topic_done(ropewalk_foreman, estate_mooring_cable))
  TAG: ropewalk_repeat_jack
  WEIGHT: 3
  VOICE: trombone_bureaucratic_short_v1
  ROPEWALK FOREMAN: "Mind the spinning jack, Corwin. Four-inch Manila doesn't stop for a uniform."

TOPIC: default
  GATE: visit_count(ropewalk_foreman) >= 2 AND NOT (topic_done(ropewalk_foreman, island_supply) AND topic_done(ropewalk_foreman, cellar_salt) AND topic_done(ropewalk_foreman, estate_mooring_cable))
  TAG: ropewalk_repeat_pitch
  WEIGHT: 2
  [He wipes powdered pitch from his palms onto a leather apron.]
  VOICE: trombone_neutral_short_v2
  ROPEWALK FOREMAN: "Still asking about private boats? Ask the water."

TOPIC: default
  GATE: topic_done(ropewalk_foreman, island_supply) AND topic_done(ropewalk_foreman, cellar_salt) AND topic_done(ropewalk_foreman, estate_mooring_cable)
  TAG: ropewalk_exhausted_coils
  WEIGHT: 3
  VOICE: trombone_dismissive_short_v1
  ROPEWALK FOREMAN: "The coils are tallied and the slips are cleared. I have no more logs for you, Officer."

TOPIC: default
  GATE: always
  TAG: ropewalk_foreman_default
  WEIGHT: 1
  VOICE: trombone_neutral_medium_v2
  ROPEWALK FOREMAN: "The quay wall's that way, Walter. Let the men work."

TOPIC: island_supply
  GATE: evidence(naomi) AND NOT topic_done(ropewalk_foreman, island_supply)
  TAG: ropewalk_foreman_island_supply
  LABEL: "Ask about supply runs to the offshore island"
  TIME: 5
  WALTER CORWIN: "The whaling station on the island. When did it last take a supply run?"
  VOICE: trombone_alarmed_medium_v2
  ROPEWALK FOREMAN: "That station's been dead ground since the flood.\nNothing goes out there on my log."
  WALTER CORWIN: "Nothing official."
  [He sets down the wooden spool he was threading. Meets Walter's eye for the first time.]
  VOICE: trombone_neutral_medium_v2
  ROPEWALK FOREMAN: "A private boat doesn't need my log.\nA private boat doesn't need anyone's log.\nThat's the point of a private boat."
  NOTEBOOK: foreman_island_supply | "The rope-walk foreman confirmed no supply run to the island appears in his ledger. He acknowledged that a private boat would leave no record. He did not say one had gone."

TOPIC: cellar_salt
  GATE: evidence(gray_salt_cakes) AND NOT topic_done(ropewalk_foreman, cellar_salt)
  TAG: ropewalk_salt
  LABEL: "Ask why someone would carry harbor curing salt inland"
  TIME: 5
  WALTER CORWIN: "Otto Kessler carried cakes of gray harbor curing salt to the estate.\nWhy would kitchen cellars need harbor salt?"
  VOICE: trombone_neutral_medium_v2
  ROPEWALK FOREMAN: "Curing salt isn't for kitchens, Walter. Kitchen salt is fine white grain."
  [He wipes powdered pitch from his palms onto a leather apron.]
  VOICE: trombone_neutral_long_v2
  ROPEWALK FOREMAN: "Grey harbor salt is packed with bitumen and dried brine scum.\nYou lay three-pound cakes along door joints and stone foundations to pull moisture out of sealed seams so timber doesn't swell shut."
  WALTER CORWIN: "To keep a door from sticking?"
  VOICE: trombone_neutral_medium_v1
  ROPEWALK FOREMAN: "Or to keep whatever is on the damp side of the stone from leaking through the mortar."
  NOTEBOOK: ropewalk_salt_purpose | "Foreman explains gray harbor salt cakes are used to desiccate stone seams and keep sealed cellar doors from swelling shut."
  EVIDENCE: cellar_desiccation_practice

TOPIC: estate_mooring_cable
  GATE: evidence(estate_conduit_map) AND NOT topic_done(ropewalk_foreman, estate_mooring_cable)
  TAG: ropewalk_cable
  LABEL: "Ask about heavy hawser supplied to the estate bluff"
  TIME: 6
  WALTER CORWIN: "Did the estate order heavy marine cordage recently?"
  VOICE: trombone_weary_medium_v1
  ROPEWALK FOREMAN: "Two hundred fathoms of four-inch tarred Manila.\nHeavy enough to anchor an eighty-ton schooner against a nor'easter."
  WALTER CORWIN: "For what purpose?"
  VOICE: trombone_bureaucratic_long_v1
  ROPEWALK FOREMAN: "Billed to Elias Pruitt's account as 'bluff retaining tackle.'\nDelivered straight to the kitchen cartway three weeks before the deaths.\nYou don't hold up a flower bed with four-inch Manila, Officer."
  NOTEBOOK: ropewalk_estate_hawser | "Foreman confirms two hundred fathoms of 4-inch tarred Manila hawser delivered to estate kitchen cartway three weeks prior."
  EVIDENCE: heavy_subterranean_tackle
  
TOPIC: island_confirmed
  GATE: evidence(chandlery_island_delivery) AND evidence(naomi_quay_inquiry) AND NOT topic_done(ropewalk_foreman, island_confirmed)
  TAG: ropewalk_foreman_island_confirmed
  LABEL: "Tell him about the chandlery sale"
  TIME: 6
  WALTER CORWIN: "Two crates of sperm oil and long tapers. Cash purchase at the chandlery yard, eight weeks ago.\nDelivered somewhere private."
  [He doesn't pick up the spool he just set down. He looks at the tide line instead.]
  VOICE: trombone_neutral_short_v1
  ROPEWALK FOREMAN: "Eight weeks."
  WALTER CORWIN: "The chandler's boy described a tall man in a good coat."
  VOICE: trombone_bureaucratic_medium_v1
  ROPEWALK FOREMAN: "There are a great many tall men in good coats in this county, Officer."
  WALTER CORWIN: "Not many of them buying lighting oil for a building the county thinks is uninhabited."
  [A long pause. A gull works the pier pilings fifty feet out.]
  VOICE: trombone_neutral_long_v2
  ROPEWALK FOREMAN: "I log what leaves the quay on registered vessels.\nEight weeks ago a dory left the repair slip after dark on a Tuesday.\nIt was back before the morning muster. I don't log dories."
  WALTER CORWIN: "Did you see who rowed it?"
  VOICE: trombone_neutral_medium_v2
  ROPEWALK FOREMAN: "I saw a shape and a lantern.\nThe lantern was the good kind. Long burn. Steady flame."
  NOTEBOOK: foreman_island_confirmed | "The rope-walk foreman noted a dory left the repair slip after dark on a Tuesday eight weeks ago and returned before morning muster. He did not log it. He saw a long-burn lantern — consistent with the chandlery's long tapers — and a single shape rowing."
  EVIDENCE: dory_night_crossing